// ParentConnect — Principal role — Attendance and Student Summary

// Focused DBML diagram for dbdiagram.io.



Project principal_attendance_and_student_summary {

  database_type: 'PostgreSQL'

  Note: 'Principal attendance context, scheduled class sessions, student profiles, linked parents, and school-year configuration. The live students-to-sections key is composite and is intentionally omitted because dbdiagram does not import composite references.'

}



Table principals {
  id int8 [pk, not null]
  employee_id text [unique, not null]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null]
  phone text [not null]
  status text [not null]
  is_active bool [unique, not null]
  password_hash text [not null]
  password_set bool [not null]
  auth_version uuid [not null]
  effective_date date
  succession_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  principal_attendance_summary_guide_completed_at timestamptz
  principal_reports_guide_completed_at timestamptz
}

Table students {
  id int4 [pk, not null]
  student_id text [unique, not null]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  gender text [not null]
  grade text
  section text
  rfid_card text [unique]
  created_at timestamptz
  transfer_status text
  target_grade text
  target_section text
  class_session text
  birth_date date
  mother_tongue text
  ip_ethnic_group text
  religion text
  house_street_sitio_purok text
  barangay text
  municipality_city text
  province text
  learning_modality text
  age int4
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table parents {
  id int4 [pk, not null]
  student_id text
  parent_first_name text [not null]
  parent_middle_name text
  parent_last_name text [not null]
  parent_suffix text
  relationship text
  contact_number text
  email text
  temp_password text
  password text [not null]
  password_set int4
  status text
  reset_token text
  reset_token_expiry timestamptz
  address text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  parent_dashboard_guide_completed_at timestamptz
  parent_attendance_guide_completed_at timestamptz
  parent_reports_guide_completed_at timestamptz
  temporary_password_expires_at timestamptz
  attendance_email_notifications bool [not null]
  attendance_sms_notifications bool [not null]
  report_submission_cooldown_until timestamptz
  attendance_notification_preference text
  login_contact_number text
  parent_remarks text
}

Table parent_student_links {
  id int8 [pk, not null]
  parent_id int8 [not null]
  student_id text [not null]
  relationship text
  created_at timestamptz [not null]
}

Table sections {
  id int4 [pk, not null]
  name text [unique, not null]
  grade text [unique, not null]
  class_session text
}

Table class_sessions {
  id int4 [pk, not null]
  session_date date [not null]
  session_type text [not null]
  scheduled_start time [not null]
  scheduled_end time [not null]
  status text [not null]
  actual_start timestamptz
  actual_end timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  late_after time
  absent_after time
  grade text
}

Table attendance_logs {
  id int4 [pk, not null]
  student_db_id int4
  student_id text
  attendance_date date [not null]
  time_logged time [not null]
  type text
  status text
  via text
  remark text
  session_type text [not null]
  class_session_id int4
  scan_request_id text
  student_grade_snapshot text
  student_section_snapshot text
  parent_recording_source text
}

Table school_year_config {
  id int4 [pk, not null]
  school_year_label varchar(20) [not null]
  start_date date [not null]
  end_date date [not null]
  is_active bool
  created_at timestamptz
  updated_at timestamptz
  attendance_weekdays text[] [not null]
}

Table student_reports {
  id int8 [pk, not null]
  student_db_id int8
  student_id text [not null]
  student_name text [not null]
  grade text [not null]
  section text [not null]
  adviser_id int8 [not null]
  parent_email text
  parent_name text
  contact text
  category text [not null]
  title text [not null]
  description text [not null]
  status text [not null]
  notified_parent bool [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  report_date_manila date [not null]
}



// Live Supabase foreign-key constraints.

Ref: parents.student_id > students.student_id

Ref: parent_student_links.parent_id > parents.id

Ref: parent_student_links.student_id > students.student_id

Ref: attendance_logs.student_db_id > students.id

Ref: attendance_logs.class_session_id > class_sessions.id

// Application-level logical references (not database constraints).
Ref: student_reports.student_id > students.student_id

// ParentConnect — Adviser role — Announcements and Parent Delivery
// This is one focused DBML diagram. It is not the complete application schema.
// Unlabelled Refs are live Supabase foreign-key constraints. Refs under the application-level heading are documented ID links without a database constraint.

Project adviser_announcements_and_parent_delivery {
  database_type: 'PostgreSQL'
  Note: 'Adviser-authored announcements and their delivery to linked parent and student notification records. announcement_id is polymorphic; the source column determines the originating announcement table.'
}
Table advisers {
  id int4 [pk, not null]
  employee_id text [unique]
  first_name text [not null]
  last_name text [not null]
  email text [unique, not null]
  phone text
  grade text
  section text
  status text
  password_hash text [not null]
  created_at timestamptz
  updated_at timestamptz
  sections text[] [not null]
  middle_name text
  password_set bool
  suffix text
  class_session text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  notifications_last_seen_at timestamptz
  adviser_attendance_guide_completed_at timestamptz
  adviser_reports_guide_completed_at timestamptz
  adviser_dashboard_guide_completed_at timestamptz
}

Table adviser_announcements {
  id int8 [pk, not null]
  adviser_id int8 [not null]
  adviser_name text [not null]
  grade text
  sections text[] [not null]
  title text [not null]
  message text [not null]
  created_at timestamptz [not null]
}

Table parents {
  id int4 [pk, not null]
  student_id text
  parent_first_name text [not null]
  parent_middle_name text
  parent_last_name text [not null]
  parent_suffix text
  relationship text
  contact_number text
  email text
  temp_password text
  password text [not null]
  password_set int4
  status text
  reset_token text
  reset_token_expiry timestamptz
  address text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  parent_dashboard_guide_completed_at timestamptz
  parent_attendance_guide_completed_at timestamptz
  parent_reports_guide_completed_at timestamptz
  temporary_password_expires_at timestamptz
  attendance_email_notifications bool [not null]
  attendance_sms_notifications bool [not null]
  report_submission_cooldown_until timestamptz
  attendance_notification_preference text
  login_contact_number text
  parent_remarks text
}

Table students {
  id int4 [pk, not null]
  student_id text [unique, not null]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  gender text [not null]
  grade text
  section text
  rfid_card text [unique]
  created_at timestamptz
  transfer_status text
  target_grade text
  target_section text
  class_session text
  birth_date date
  mother_tongue text
  ip_ethnic_group text
  religion text
  house_street_sitio_purok text
  barangay text
  municipality_city text
  province text
  learning_modality text
  age int4
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table parent_student_links {
  id int8 [pk, not null]
  parent_id int8 [not null]
  student_id text [not null]
  relationship text
  created_at timestamptz [not null]
}

Table parent_announcement_notifications {
  id int8 [pk, not null]
  announcement_id int8 [not null]
  parent_id int8 [not null]
  student_id text
  grade text
  section text
  read_at timestamptz
  created_at timestamptz [not null]
  source text
  title text
  message text
  sender_name text
  unread bool [not null]
  tab text [not null]
}

// Live Supabase foreign-key constraints.
Ref: adviser_announcements.adviser_id > advisers.id
Ref: parent_student_links.parent_id > parents.id
Ref: parent_student_links.student_id > students.student_id
Ref: parent_announcement_notifications.parent_id > parents.id
Ref: parent_announcement_notifications.student_id > students.student_id

// Application-level logical references (not database constraints).
Ref: parent_announcement_notifications.announcement_id > adviser_announcements.id

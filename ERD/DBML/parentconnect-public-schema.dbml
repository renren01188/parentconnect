// PARENTCONNECT: complete live public-schema DBML
// Inspected through Supabase MCP on 2026-09-24. No application or database changes were made.
// All 43 tables and all 536 live columns are included. Ref statements represent declared FKs only.
// Logical-only application associations are documented in LOGICAL-RELATIONSHIPS.md; they are not fabricated as Ref lines.

Project parentconnect_public {
  database_type: 'PostgreSQL'
  Note: 'Complete 43-table, 536-column public schema. Tables are grouped by application module.'
}

TableGroup identity_and_people {
  students
  parents
  student_family_members
  advisers
  guidance_counselors
  principals
  ict_admins
}

TableGroup academic_and_attendance {
  sections
  class_sessions
  school_year_config
  attendance_logs
  attendance_sms_jobs
  parent_attendance_notification_reads
}

TableGroup parent_reports_and_links {
  parent_student_links
  excuse_letters
  parent_adviser_reports
  parent_adviser_report_messages
  parent_report_guidance_tickets
  student_reports
}

TableGroup staff_workflows_and_messages {
  adviser_change_requests
  adviser_assignment_history
  guidance_change_requests
  adviser_principal_messages
  principal_staff_messages
  staff_messages
}

TableGroup announcements_and_notifications {
  announcements
  adviser_notifications
  adviser_notification_reads
  guidance_announcements
  guidance_notification_reads
  ict_announcements
  ict_notification_reads
  principal_announcements
  principal_notification_reads
  adviser_announcements
  parent_announcement_notifications
}

TableGroup audit_security_and_jobs {
  audit_log
  login_attempt_guards
  parent_password_reset_otps
  subject_teacher_report_otps
  scheduled_deletions
  deletion_email_jobs
  contact_us_messages
}

Table students {
  id integer [pk, not null]
  student_id text [not null, unique]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  gender text [not null]
  grade text
  section text
  rfid_card text [unique]
  created_at timestamptz
  transfer_status text
  target_grade text
  target_section text
  class_session text
  birth_date date
  mother_tongue text
  ip_ethnic_group text
  religion text
  house_street_sitio_purok text
  barangay text
  municipality_city text
  province text
  learning_modality text
  age integer
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  parent_dashboard_guide_completed_at timestamptz // Parent Dashboard quick-guide completion timestamp
  parent_attendance_guide_completed_at timestamptz // Parent Attendance quick-guide completion timestamp
  parent_reports_guide_completed_at timestamptz // Parent Reports quick-guide completion timestamp
}

Table parents {
  id integer [pk, not null]
  student_id text // FK -> students.student_id
  parent_first_name text [not null]
  parent_middle_name text
  parent_last_name text [not null]
  parent_suffix text
  relationship text
  contact_number text
  email text [not null]
  temp_password text
  password text [not null]
  password_set integer
  status text
  reset_token text
  reset_token_expiry timestamptz
  address text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table student_family_members {
  id bigint [pk, not null]
  student_db_id integer [not null] // FK -> students.id
  role text [not null]
  first_name text
  middle_name text
  last_name text
  relationship text
  contact_number text
  created_at timestamptz [not null]
  suffix text

  indexes {
    (student_db_id, role) [unique]
  }
}

Table advisers {
  id integer [pk, not null]
  employee_id text [unique]
  first_name text [not null]
  last_name text [not null]
  email text [not null, unique]
  phone text
  grade text
  section text
  status text
  password_hash text [not null]
  created_at timestamptz
  updated_at timestamptz
  sections text[] [not null]
  middle_name text
  password_set boolean
  suffix text
  class_session text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  notifications_last_seen_at timestamptz
  adviser_dashboard_guide_completed_at timestamptz // Dashboard quick-guide completion timestamp
  adviser_attendance_guide_completed_at timestamptz // RFID Attendance quick-guide completion timestamp
  adviser_reports_guide_completed_at timestamptz // Reports & Messages quick-guide completion timestamp
}

Table guidance_counselors {
  id bigint [pk, not null]
  employee_id text [not null, unique]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null, unique]
  phone text [not null]
  status text [not null]
  password_hash text [not null]
  password_set boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  guidance_dashboard_guide_completed_at timestamptz // Dashboard quick-guide completion timestamp
  guidance_reports_guide_completed_at timestamptz // Reports quick-guide completion timestamp
}

Table principals {
  id bigint [pk, not null]
  employee_id text [not null]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null]
  phone text [not null]
  status text [not null]
  is_active boolean [not null]
  password_hash text [not null]
  password_set boolean [not null]
  auth_version uuid [not null]
  effective_date date
  succession_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  principal_attendance_summary_guide_completed_at timestamptz // Attendance Summary quick-guide completion timestamp
  principal_reports_guide_completed_at timestamptz // Reports quick-guide completion timestamp
}

Table ict_admins {
  id bigint [pk, not null]
  employee_id text [not null, unique]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null, unique]
  phone text [not null]
  status text [not null]
  password_hash text [not null]
  password_set boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  ict_dashboard_guide_completed_at timestamptz // Dashboard quick-guide completion timestamp
}

Table sections {
  id integer [pk, not null]
  name text [not null]
  grade text [not null]
  class_session text

  indexes {
    (name, grade) [unique]
  }
}

Table class_sessions {
  id integer [pk, not null]
  session_date date [not null]
  session_type text [not null]
  scheduled_start time [not null]
  scheduled_end time [not null]
  status text [not null]
  actual_start timestamptz
  actual_end timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  late_after time
  absent_after time
}

Table school_year_config {
  id integer [pk, not null]
  school_year_label varchar(20) [not null]
  start_date date [not null]
  end_date date [not null]
  is_active boolean
  created_at timestamptz
  updated_at timestamptz
}

Table attendance_logs {
  id integer [pk, not null]
  student_db_id integer // FK -> students.id
  student_id text
  attendance_date date [not null]
  time_logged time [not null]
  type text
  status text
  via text
  remark text
  session_type text [not null]
}

Table attendance_sms_jobs {
  id uuid [pk, not null]
  attendance_log_id bigint [not null, unique] // FK -> attendance_logs.id
  parent_id integer // FK -> parents.id
  recipient_phone text
  recipient_key text [not null]
  message text [not null]
  status text [not null]
  attempts integer [not null]
  available_at timestamptz [not null]
  locked_at timestamptz
  sent_at timestamptz
  delivered_at timestamptz
  provider text
  provider_message_id text
  provider_status text
  provider_response jsonb
  last_error text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table parent_attendance_notification_reads {
  parent_id integer [pk, not null] // FK -> parents.id
  attendance_log_id bigint [pk, not null] // FK -> attendance_logs.id
  read_at timestamptz [not null]
}

Table parent_student_links {
  id bigint [pk, not null]
  parent_id bigint [not null] // FK -> parents.id
  student_id text [not null] // FK -> students.student_id
  relationship text
  created_at timestamptz [not null]

  indexes {
    (parent_id, student_id) [unique]
  }
}

Table excuse_letters {
  id integer [pk, not null]
  student_id text [not null] // FK -> students.student_id
  parent_id integer [not null]
  date_from date [not null]
  date_to date [not null]
  message text [not null]
  status text [not null]
  decline_reason text
  submitted_at timestamptz [not null]
  file_name text
  file_data text
  file_type text
  attachment_uploaded_at timestamptz
}

Table parent_adviser_reports {
  id bigint [pk, not null]
  parent_id bigint
  parent_email text [not null]
  parent_name text [not null]
  adviser_id bigint
  adviser_name text [not null]
  student_id text [not null]
  student_name text [not null]
  grade text
  section text
  subject text [not null]
  categories text[] [not null]
  concern_level integer [not null]
  status text [not null]
  escalated_to_guidance boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  last_message_at timestamptz [not null]
  parent_seen_at timestamptz
  status_updated_at timestamptz [not null]
  escalated_to_principal boolean [not null]
  guidance_seen_at timestamptz
  allow_history_access boolean
  subject_teacher_email text
  subject_teacher_report_date_manila date
}

Table parent_adviser_report_messages {
  id bigint [pk, not null]
  report_id bigint [not null] // FK -> parent_adviser_reports.id
  sender_role text [not null]
  sender_name text [not null]
  body text [not null]
  created_at timestamptz [not null]
  read_by_parent boolean [not null]
  read_by_adviser boolean [not null]
  attachments jsonb [not null]
  thread_type text [not null]
}

Table parent_report_guidance_tickets {
  id bigint [pk, not null]
  report_id bigint [not null, unique] // FK -> parent_adviser_reports.id
  parent_id bigint [not null] // FK -> parents.id
  student_id text [not null]
  adviser_id bigint // FK -> advisers.id
  concern text [not null]
  message text [not null]
  attachments jsonb [not null]
  status text [not null]
  rejection_reason text
  assigned_guidance_id bigint // FK -> guidance_counselors.id
  created_at timestamptz [not null]
  decided_at timestamptz
  updated_at timestamptz [not null]
}

Table student_reports {
  id bigint [pk, not null]
  student_db_id bigint
  student_id text [not null]
  student_name text [not null]
  grade text [not null]
  section text [not null]
  adviser_id bigint [not null]
  parent_email text
  parent_name text
  contact text
  category text [not null]
  title text [not null]
  description text [not null]
  status text [not null]
  notified_parent boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  report_date_manila date [not null]
}

Table adviser_change_requests {
  id bigint [pk, not null]
  adviser_id integer [not null]
  adviser_name text [not null]
  adviser_email text [not null]
  adviser_initials text [not null]
  class_grade text [not null]
  status text [not null]
  changes jsonb [not null]
  note text
  reviewed_at timestamptz
  review_note text
  created_at timestamptz [not null]
  reviewed_by_ict_id integer
}

Table adviser_assignment_history {
  id bigint [pk, not null]
  adviser_id integer [not null] // FK -> advisers.id
  request_id bigint // FK -> adviser_change_requests.id
  previous_grade text
  previous_sections text[] [not null]
  new_grade text
  new_sections text[] [not null]
  approved_by_ict_id integer
  effective_at timestamptz [not null]
}

Table guidance_change_requests {
  id bigint [pk, not null]
  guidance_id bigint [not null] // FK -> guidance_counselors.id
  guidance_name text [not null]
  guidance_email text [not null]
  guidance_initials text [not null]
  changes jsonb [not null]
  note text
  status text [not null]
  created_at timestamptz [not null]
  reviewed_at timestamptz
  reviewed_by_ict_id bigint // FK -> ict_admins.id
  review_note text
}

Table adviser_principal_messages {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  adviser_name text [not null]
  adviser_email text
  principal_id bigint [not null] // FK -> principals.id
  subject text [not null]
  categories text[] [not null]
  body text [not null]
  status text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  source_staff_message_id bigint // FK -> principal_staff_messages.id
  attachments jsonb [not null]
}

Table principal_staff_messages {
  id bigint [pk, not null]
  principal_id bigint [not null] // FK -> principals.id
  principal_name text [not null]
  recipient_type text [not null]
  recipient_id bigint [not null]
  recipient_name text [not null]
  recipient_email text
  subject text [not null]
  categories text[] [not null]
  body text [not null]
  status text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  attachments jsonb [not null]
  source_adviser_message_id bigint // FK -> adviser_principal_messages.id
}

Table staff_messages {
  id bigint [pk, not null]
  sender_type text [not null]
  sender_id bigint [not null]
  sender_name text [not null]
  sender_email text
  recipient_type text [not null]
  recipient_id bigint [not null]
  recipient_name text [not null]
  recipient_email text
  subject text [not null]
  categories text[] [not null]
  body text [not null]
  attachments jsonb [not null]
  status text [not null]
  source_message_id bigint // FK -> staff_messages.id
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table announcements {
  id bigint [pk, not null]
  sender_id bigint [not null]
  title text [not null]
  message text [not null]
  audience text [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz
}

Table adviser_notifications {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  announcement_id bigint [not null] // FK -> announcements.id
  notif_key text [unique]
  title text [not null]
  message text [not null]
  type text [not null]
  read boolean [not null]
  date text [not null]
  created_at timestamptz
}

Table adviser_notification_reads {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  notif_key text [not null]
  read_at timestamptz

  indexes {
    (adviser_id, notif_key) [unique]
  }
}

Table guidance_announcements {
  id bigint [pk, not null]
  guidance_id bigint [not null]
  guidance_name text [not null]
  title text [not null]
  message text [not null]
  audience text [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  emails_sent boolean
}

Table guidance_notification_reads {
  id integer [pk, not null]
  guidance_id integer [not null]
  notif_key text [not null]
  created_at timestamptz

  indexes {
    (guidance_id, notif_key) [unique]
  }
}

Table ict_announcements {
  id bigint [pk, not null]
  sender_id bigint [not null]
  sender_name text
  title text [not null]
  message text [not null]
  audience text[] [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz
  emails_sent boolean
}

Table ict_notification_reads {
  id bigint [pk, not null]
  ict_id bigint [not null]
  notif_key text [not null]
  created_at timestamptz

  indexes {
    (ict_id, notif_key) [unique]
  }
}

Table principal_announcements {
  id bigint [pk, not null]
  sender_id text [not null]
  title text [not null]
  message text [not null]
  audience text [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz
  emails_sent boolean
}

Table principal_notification_reads {
  id bigint [pk, not null]
  principal_id bigint [not null] // FK -> principals.id
  notif_key text [not null]
  created_at timestamptz

  indexes {
    (principal_id, notif_key) [unique]
  }
}

Table adviser_announcements {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  adviser_name text [not null]
  grade text
  sections text[] [not null]
  title text [not null]
  message text [not null]
  created_at timestamptz [not null]
}

Table parent_announcement_notifications {
  id bigint [pk, not null]
  announcement_id bigint [not null]
  parent_id bigint [not null]
  student_id text
  grade text
  section text
  read_at timestamptz
  created_at timestamptz [not null]
  source text
  title text
  message text
  sender_name text
  unread boolean [not null]
  tab text [not null]

  indexes {
    (source, announcement_id, parent_id) [unique]
  }
}

Table audit_log {
  id bigint [pk, not null]
  action text [not null]
  target_user text [not null]
  target_role text [not null]
  target_email text [not null]
  performed_by text [not null]
  details text
  changes jsonb
  created_at timestamptz [not null]
  ip_address text
  browser text
  module text
  performed_by_role text
  performed_by_id text
  performed_by_email text
  target_type text [not null]
  target_id text
  previous_status text
  new_status text
  related_report_id text
  related_ticket_id text
  related_student_id text
  related_user_id text
  metadata jsonb
}

Table login_attempt_guards {
  role text [pk, not null]
  subject_hash text [pk, not null]
  failed_attempts integer [not null]
  locked_until timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  scope text [pk, not null]
  lockout_level integer [not null]
  last_failed_at timestamptz
}

Table parent_password_reset_otps {
  parent_id integer [pk, not null] // FK -> parents.id
  otp_hash text [not null]
  expires_at timestamptz [not null]
  attempts smallint [not null]
  requested_at timestamptz [not null]
}

Table subject_teacher_report_otps {
  email text [pk, not null]
  otp_hash text [not null]
  expires_at timestamptz [not null]
  attempts smallint [not null]
  requested_at timestamptz [not null]
}

Table scheduled_deletions {
  id bigint [pk, not null]
  target_type text [not null]
  target_id text [not null]
  target_name text [not null]
  target_email text
  requested_by_role text [not null]
  requested_by_id bigint [not null]
  reason text [not null]
  status text [not null]
  requested_at timestamptz [not null]
  approved_at timestamptz
  approved_by_ict_id bigint
  delete_after timestamptz
  restored_at timestamptz
  notice_sent_at timestamptz
  archived_at timestamptz
  archived_by text
  archive_reason text
}

Table deletion_email_jobs {
  id uuid [pk, not null]
  batch_id uuid [not null]
  recipient_email text [not null]
  recipient_email_normalized text
  recipient_name text [not null]
  target_names text[] [not null]
  scheduled_deletion_ids bigint[] [not null]
  reason text [not null]
  delete_after timestamptz [not null]
  status text [not null]
  attempts integer [not null]
  available_at timestamptz [not null]
  locked_at timestamptz
  sent_at timestamptz
  last_error text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (batch_id, recipient_email_normalized) [unique]
  }
}

Table contact_us_messages {
  id bigint [pk, not null]
  idempotency_key uuid [not null, unique]
  sender_name text [not null]
  sender_email text [not null]
  sender_phone text
  subject text [not null]
  message text [not null]
  notification_status text [not null]
  notification_error text
  notified_at timestamptz
  created_at timestamptz [not null]
}

// Declared Supabase foreign keys only.
Ref: adviser_assignment_history.adviser_id > advisers.id
Ref: adviser_assignment_history.request_id > adviser_change_requests.id
Ref: adviser_notifications.announcement_id > announcements.id
Ref: adviser_principal_messages.principal_id > principals.id
Ref: adviser_principal_messages.source_staff_message_id > principal_staff_messages.id
Ref: attendance_logs.student_db_id > students.id
Ref: attendance_sms_jobs.attendance_log_id - attendance_logs.id
Ref: attendance_sms_jobs.parent_id > parents.id
Ref: excuse_letters.student_id > students.student_id
Ref: guidance_change_requests.guidance_id > guidance_counselors.id
Ref: guidance_change_requests.reviewed_by_ict_id > ict_admins.id
Ref: parent_adviser_report_messages.report_id > parent_adviser_reports.id
Ref: parent_attendance_notification_reads.attendance_log_id > attendance_logs.id
Ref: parent_attendance_notification_reads.parent_id > parents.id
Ref: parent_password_reset_otps.parent_id - parents.id
Ref: parent_report_guidance_tickets.adviser_id > advisers.id
Ref: parent_report_guidance_tickets.assigned_guidance_id > guidance_counselors.id
Ref: parent_report_guidance_tickets.parent_id > parents.id
Ref: parent_report_guidance_tickets.report_id - parent_adviser_reports.id
Ref: parent_student_links.parent_id > parents.id
Ref: parent_student_links.student_id > students.student_id
Ref: parents.student_id > students.student_id
Ref: principal_notification_reads.principal_id > principals.id
Ref: principal_staff_messages.principal_id > principals.id
Ref: principal_staff_messages.source_adviser_message_id > adviser_principal_messages.id
Ref: staff_messages.source_message_id > staff_messages.id
Ref: student_family_members.student_db_id > students.id


// DrawSQL split import: Staff accounts, change workflows, and staff messaging
// 11 tables. Only relationships whose two tables are in this import are included.
// This prevents DrawSQL from reporting skipped references to tables in other split diagrams.

Project parentconnect_drawsql_split {
  database_type: 'PostgreSQL'
  Note: 'Staff accounts, change workflows, and staff messaging. Derived from the live PARENTCONNECT public schema.'
}

TableGroup accounts_and_staff_workflows {
  advisers
  guidance_counselors
  principals
  ict_admins
  adviser_change_requests
  adviser_assignment_history
  guidance_change_requests
  adviser_principal_messages
  principal_staff_messages
  staff_messages
  principal_notification_reads
}

Table advisers {
  id integer [pk, not null]
  employee_id text [unique]
  first_name text [not null]
  last_name text [not null]
  email text [not null, unique]
  phone text
  grade text
  section text
  status text
  password_hash text [not null]
  created_at timestamptz
  updated_at timestamptz
  sections text[] [not null]
  middle_name text
  password_set boolean
  suffix text
  class_session text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  notifications_last_seen_at timestamptz
}

Table guidance_counselors {
  id bigint [pk, not null]
  employee_id text [not null, unique]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null, unique]
  phone text [not null]
  status text [not null]
  password_hash text [not null]
  password_set boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table principals {
  id bigint [pk, not null]
  employee_id text [not null]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null]
  phone text [not null]
  status text [not null]
  is_active boolean [not null]
  password_hash text [not null]
  password_set boolean [not null]
  auth_version uuid [not null]
  effective_date date
  succession_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table ict_admins {
  id bigint [pk, not null]
  employee_id text [not null, unique]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null, unique]
  phone text [not null]
  status text [not null]
  password_hash text [not null]
  password_set boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table adviser_change_requests {
  id bigint [pk, not null]
  adviser_id integer [not null]
  adviser_name text [not null]
  adviser_email text [not null]
  adviser_initials text [not null]
  class_grade text [not null]
  status text [not null]
  changes jsonb [not null]
  note text
  reviewed_at timestamptz
  review_note text
  created_at timestamptz [not null]
  reviewed_by_ict_id integer
}

Table adviser_assignment_history {
  id bigint [pk, not null]
  adviser_id integer [not null] // FK -> advisers.id
  request_id bigint // FK -> adviser_change_requests.id
  previous_grade text
  previous_sections text[] [not null]
  new_grade text
  new_sections text[] [not null]
  approved_by_ict_id integer
  effective_at timestamptz [not null]
}

Table guidance_change_requests {
  id bigint [pk, not null]
  guidance_id bigint [not null] // FK -> guidance_counselors.id
  guidance_name text [not null]
  guidance_email text [not null]
  guidance_initials text [not null]
  changes jsonb [not null]
  note text
  status text [not null]
  created_at timestamptz [not null]
  reviewed_at timestamptz
  reviewed_by_ict_id bigint // FK -> ict_admins.id
  review_note text
}

Table adviser_principal_messages {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  adviser_name text [not null]
  adviser_email text
  principal_id bigint [not null] // FK -> principals.id
  subject text [not null]
  categories text[] [not null]
  body text [not null]
  status text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  source_staff_message_id bigint // FK -> principal_staff_messages.id
  attachments jsonb [not null]
}

Table principal_staff_messages {
  id bigint [pk, not null]
  principal_id bigint [not null] // FK -> principals.id
  principal_name text [not null]
  recipient_type text [not null]
  recipient_id bigint [not null]
  recipient_name text [not null]
  recipient_email text
  subject text [not null]
  categories text[] [not null]
  body text [not null]
  status text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  attachments jsonb [not null]
  source_adviser_message_id bigint // FK -> adviser_principal_messages.id
}

Table staff_messages {
  id bigint [pk, not null]
  sender_type text [not null]
  sender_id bigint [not null]
  sender_name text [not null]
  sender_email text
  recipient_type text [not null]
  recipient_id bigint [not null]
  recipient_name text [not null]
  recipient_email text
  subject text [not null]
  categories text[] [not null]
  body text [not null]
  attachments jsonb [not null]
  status text [not null]
  source_message_id bigint // FK -> staff_messages.id
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table principal_notification_reads {
  id bigint [pk, not null]
  principal_id bigint [not null] // FK -> principals.id
  notif_key text [not null]
  created_at timestamptz

  indexes {
    (principal_id, notif_key) [unique]
  }
}

// Declared foreign keys represented within this import only.
Ref: adviser_assignment_history.adviser_id > advisers.id
Ref: adviser_assignment_history.request_id > adviser_change_requests.id
Ref: adviser_principal_messages.principal_id > principals.id
Ref: adviser_principal_messages.source_staff_message_id > principal_staff_messages.id
Ref: guidance_change_requests.guidance_id > guidance_counselors.id
Ref: guidance_change_requests.reviewed_by_ict_id > ict_admins.id
Ref: principal_notification_reads.principal_id > principals.id
Ref: principal_staff_messages.principal_id > principals.id
Ref: principal_staff_messages.source_adviser_message_id > adviser_principal_messages.id
Ref: staff_messages.source_message_id > staff_messages.id


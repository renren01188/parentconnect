// DrawSQL split import: Audit trail, security, reset, and scheduled jobs
// 8 tables. Only relationships whose two tables are in this import are included.
// This prevents DrawSQL from reporting skipped references to tables in other split diagrams.

Project parentconnect_drawsql_split {
  database_type: 'PostgreSQL'
  Note: 'Audit trail, security, reset, and scheduled jobs. Derived from the live PARENTCONNECT public schema.'
}

TableGroup audit_security_and_jobs {
  audit_log
  login_attempt_guards
  parent_password_reset_otps
  subject_teacher_report_otps
  scheduled_deletions
  deletion_email_jobs
  contact_us_messages
  parents
}

Table audit_log {
  id bigint [pk, not null]
  action text [not null]
  target_user text [not null]
  target_role text [not null]
  target_email text [not null]
  performed_by text [not null]
  details text
  changes jsonb
  created_at timestamptz [not null]
  ip_address text
  browser text
  module text
  performed_by_role text
  performed_by_id text
  performed_by_email text
  target_type text [not null]
  target_id text
  previous_status text
  new_status text
  related_report_id text
  related_ticket_id text
  related_student_id text
  related_user_id text
  metadata jsonb
}

Table login_attempt_guards {
  role text [pk, not null]
  subject_hash text [pk, not null]
  failed_attempts integer [not null]
  locked_until timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  scope text [pk, not null]
  lockout_level integer [not null]
  last_failed_at timestamptz
}

Table parent_password_reset_otps {
  parent_id integer [pk, not null] // FK -> parents.id
  otp_hash text [not null]
  expires_at timestamptz [not null]
  attempts smallint [not null]
  requested_at timestamptz [not null]
}

Table subject_teacher_report_otps {
  email text [pk, not null]
  otp_hash text [not null]
  expires_at timestamptz [not null]
  attempts smallint [not null]
  requested_at timestamptz [not null]
}

Table scheduled_deletions {
  id bigint [pk, not null]
  target_type text [not null]
  target_id text [not null]
  target_name text [not null]
  target_email text
  requested_by_role text [not null]
  requested_by_id bigint [not null]
  reason text [not null]
  status text [not null]
  requested_at timestamptz [not null]
  approved_at timestamptz
  approved_by_ict_id bigint
  delete_after timestamptz
  restored_at timestamptz
  notice_sent_at timestamptz
  archived_at timestamptz
  archived_by text
  archive_reason text
}

Table deletion_email_jobs {
  id uuid [pk, not null]
  batch_id uuid [not null]
  recipient_email text [not null]
  recipient_email_normalized text
  recipient_name text [not null]
  target_names text[] [not null]
  scheduled_deletion_ids bigint[] [not null]
  reason text [not null]
  delete_after timestamptz [not null]
  status text [not null]
  attempts integer [not null]
  available_at timestamptz [not null]
  locked_at timestamptz
  sent_at timestamptz
  last_error text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (batch_id, recipient_email_normalized) [unique]
  }
}

Table contact_us_messages {
  id bigint [pk, not null]
  idempotency_key uuid [not null, unique]
  sender_name text [not null]
  sender_email text [not null]
  sender_phone text
  subject text [not null]
  message text [not null]
  notification_status text [not null]
  notification_error text
  notified_at timestamptz
  created_at timestamptz [not null]
}

Table parents {
  id integer [pk, not null]
  student_id text // FK -> students.student_id
  parent_first_name text [not null]
  parent_middle_name text
  parent_last_name text [not null]
  parent_suffix text
  relationship text
  contact_number text
  email text [not null]
  temp_password text
  password text [not null]
  password_set integer
  status text
  reset_token text
  reset_token_expiry timestamptz
  address text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

// Declared foreign keys represented within this import only.
Ref: parent_password_reset_otps.parent_id - parents.id


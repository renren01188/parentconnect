// DrawSQL split import: Parent reports, messages, tickets, and guidance
// 7 tables. Only relationships whose two tables are in this import are included.
// This prevents DrawSQL from reporting skipped references to tables in other split diagrams.

Project parentconnect_drawsql_split {
  database_type: 'PostgreSQL'
  Note: 'Parent reports, messages, tickets, and guidance. Derived from the live PARENTCONNECT public schema.'
}

TableGroup parent_reports_and_guidance {
  parents
  advisers
  guidance_counselors
  parent_adviser_reports
  parent_adviser_report_messages
  parent_report_guidance_tickets
  student_reports
}

Table parents {
  id integer [pk, not null]
  student_id text // FK -> students.student_id
  parent_first_name text [not null]
  parent_middle_name text
  parent_last_name text [not null]
  parent_suffix text
  relationship text
  contact_number text
  email text [not null]
  temp_password text
  password text [not null]
  password_set integer
  status text
  reset_token text
  reset_token_expiry timestamptz
  address text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table advisers {
  id integer [pk, not null]
  employee_id text [unique]
  first_name text [not null]
  last_name text [not null]
  email text [not null, unique]
  phone text
  grade text
  section text
  status text
  password_hash text [not null]
  created_at timestamptz
  updated_at timestamptz
  sections text[] [not null]
  middle_name text
  password_set boolean
  suffix text
  class_session text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
  notifications_last_seen_at timestamptz
}

Table guidance_counselors {
  id bigint [pk, not null]
  employee_id text [not null, unique]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null, unique]
  phone text [not null]
  status text [not null]
  password_hash text [not null]
  password_set boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table parent_adviser_reports {
  id bigint [pk, not null]
  parent_id bigint
  parent_email text [not null]
  parent_name text [not null]
  adviser_id bigint
  adviser_name text [not null]
  student_id text [not null]
  student_name text [not null]
  grade text
  section text
  subject text [not null]
  categories text[] [not null]
  concern_level integer [not null]
  status text [not null]
  escalated_to_guidance boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  last_message_at timestamptz [not null]
  parent_seen_at timestamptz
  status_updated_at timestamptz [not null]
  escalated_to_principal boolean [not null]
  guidance_seen_at timestamptz
  allow_history_access boolean
  subject_teacher_email text
  subject_teacher_report_date_manila date
}

Table parent_adviser_report_messages {
  id bigint [pk, not null]
  report_id bigint [not null] // FK -> parent_adviser_reports.id
  sender_role text [not null]
  sender_name text [not null]
  body text [not null]
  created_at timestamptz [not null]
  read_by_parent boolean [not null]
  read_by_adviser boolean [not null]
  attachments jsonb [not null]
  thread_type text [not null]
}

Table parent_report_guidance_tickets {
  id bigint [pk, not null]
  report_id bigint [not null, unique] // FK -> parent_adviser_reports.id
  parent_id bigint [not null] // FK -> parents.id
  student_id text [not null]
  adviser_id bigint // FK -> advisers.id
  concern text [not null]
  message text [not null]
  attachments jsonb [not null]
  status text [not null]
  rejection_reason text
  assigned_guidance_id bigint // FK -> guidance_counselors.id
  created_at timestamptz [not null]
  decided_at timestamptz
  updated_at timestamptz [not null]
}

Table student_reports {
  id bigint [pk, not null]
  student_db_id bigint
  student_id text [not null]
  student_name text [not null]
  grade text [not null]
  section text [not null]
  adviser_id bigint [not null]
  parent_email text
  parent_name text
  contact text
  category text [not null]
  title text [not null]
  description text [not null]
  status text [not null]
  notified_parent boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  report_date_manila date [not null]
}

// Declared foreign keys represented within this import only.
Ref: parent_adviser_report_messages.report_id > parent_adviser_reports.id
Ref: parent_report_guidance_tickets.adviser_id > advisers.id
Ref: parent_report_guidance_tickets.assigned_guidance_id > guidance_counselors.id
Ref: parent_report_guidance_tickets.parent_id > parents.id
Ref: parent_report_guidance_tickets.report_id - parent_adviser_reports.id


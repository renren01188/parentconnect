// DrawSQL split import: Students, parents, family, and attendance
// 11 tables. Only relationships whose two tables are in this import are included.
// This prevents DrawSQL from reporting skipped references to tables in other split diagrams.

Project parentconnect_drawsql_split {
  database_type: 'PostgreSQL'
  Note: 'Students, parents, family, and attendance. Derived from the live PARENTCONNECT public schema.'
}

TableGroup students_and_attendance {
  students
  parents
  student_family_members
  parent_student_links
  excuse_letters
  sections
  class_sessions
  school_year_config
  attendance_logs
  attendance_sms_jobs
  parent_attendance_notification_reads
}

Table students {
  id integer [pk, not null]
  student_id text [not null, unique]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  gender text [not null]
  grade text
  section text
  rfid_card text [unique]
  created_at timestamptz
  transfer_status text
  target_grade text
  target_section text
  class_session text
  birth_date date
  mother_tongue text
  ip_ethnic_group text
  religion text
  house_street_sitio_purok text
  barangay text
  municipality_city text
  province text
  learning_modality text
  age integer
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table parents {
  id integer [pk, not null]
  student_id text // FK -> students.student_id
  parent_first_name text [not null]
  parent_middle_name text
  parent_last_name text [not null]
  parent_suffix text
  relationship text
  contact_number text
  email text [not null]
  temp_password text
  password text [not null]
  password_set integer
  status text
  reset_token text
  reset_token_expiry timestamptz
  address text
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

Table student_family_members {
  id bigint [pk, not null]
  student_db_id integer [not null] // FK -> students.id
  role text [not null]
  first_name text
  middle_name text
  last_name text
  relationship text
  contact_number text
  created_at timestamptz [not null]
  suffix text

  indexes {
    (student_db_id, role) [unique]
  }
}

Table parent_student_links {
  id bigint [pk, not null]
  parent_id bigint [not null] // FK -> parents.id
  student_id text [not null] // FK -> students.student_id
  relationship text
  created_at timestamptz [not null]

  indexes {
    (parent_id, student_id) [unique]
  }
}

Table excuse_letters {
  id integer [pk, not null]
  student_id text [not null] // FK -> students.student_id
  parent_id integer [not null]
  date_from date [not null]
  date_to date [not null]
  message text [not null]
  status text [not null]
  decline_reason text
  submitted_at timestamptz [not null]
  file_name text
  file_data text
  file_type text
  attachment_uploaded_at timestamptz
}

Table sections {
  id integer [pk, not null]
  name text [not null]
  grade text [not null]
  class_session text

  indexes {
    (name, grade) [unique]
  }
}

Table class_sessions {
  id integer [pk, not null]
  session_date date [not null]
  session_type text [not null]
  scheduled_start time [not null]
  scheduled_end time [not null]
  status text [not null]
  actual_start timestamptz
  actual_end timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  late_after time
  absent_after time
}

Table school_year_config {
  id integer [pk, not null]
  school_year_label varchar(20) [not null]
  start_date date [not null]
  end_date date [not null]
  is_active boolean
  created_at timestamptz
  updated_at timestamptz
}

Table attendance_logs {
  id integer [pk, not null]
  student_db_id integer // FK -> students.id
  student_id text
  attendance_date date [not null]
  time_logged time [not null]
  type text
  status text
  via text
  remark text
  session_type text [not null]
}

Table attendance_sms_jobs {
  id uuid [pk, not null]
  attendance_log_id bigint [not null, unique] // FK -> attendance_logs.id
  parent_id integer // FK -> parents.id
  recipient_phone text
  recipient_key text [not null]
  message text [not null]
  status text [not null]
  attempts integer [not null]
  available_at timestamptz [not null]
  locked_at timestamptz
  sent_at timestamptz
  delivered_at timestamptz
  provider text
  provider_message_id text
  provider_status text
  provider_response jsonb
  last_error text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table parent_attendance_notification_reads {
  parent_id integer [pk, not null] // FK -> parents.id
  attendance_log_id bigint [pk, not null] // FK -> attendance_logs.id
  read_at timestamptz [not null]
}

// Declared foreign keys represented within this import only.
Ref: attendance_logs.student_db_id > students.id
Ref: attendance_sms_jobs.attendance_log_id - attendance_logs.id
Ref: attendance_sms_jobs.parent_id > parents.id
Ref: excuse_letters.student_id > students.student_id
Ref: parent_attendance_notification_reads.attendance_log_id > attendance_logs.id
Ref: parent_attendance_notification_reads.parent_id > parents.id
Ref: parent_student_links.parent_id > parents.id
Ref: parent_student_links.student_id > students.student_id
Ref: parents.student_id > students.student_id
Ref: student_family_members.student_db_id > students.id


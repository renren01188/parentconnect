// DrawSQL split import: Announcements and notification records
// 12 tables. Only relationships whose two tables are in this import are included.
// This prevents DrawSQL from reporting skipped references to tables in other split diagrams.

Project parentconnect_drawsql_split {
  database_type: 'PostgreSQL'
  Note: 'Announcements and notification records. Derived from the live PARENTCONNECT public schema.'
}

TableGroup announcements_and_notifications {
  announcements
  adviser_notifications
  adviser_notification_reads
  adviser_announcements
  guidance_announcements
  guidance_notification_reads
  ict_announcements
  ict_notification_reads
  principal_announcements
  principal_notification_reads
  parent_announcement_notifications
  principals
}

Table announcements {
  id bigint [pk, not null]
  sender_id bigint [not null]
  title text [not null]
  message text [not null]
  audience text [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz
}

Table adviser_notifications {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  announcement_id bigint [not null] // FK -> announcements.id
  notif_key text [unique]
  title text [not null]
  message text [not null]
  type text [not null]
  read boolean [not null]
  date text [not null]
  created_at timestamptz
}

Table adviser_notification_reads {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  notif_key text [not null]
  read_at timestamptz

  indexes {
    (adviser_id, notif_key) [unique]
  }
}

Table adviser_announcements {
  id bigint [pk, not null]
  adviser_id bigint [not null]
  adviser_name text [not null]
  grade text
  sections text[] [not null]
  title text [not null]
  message text [not null]
  created_at timestamptz [not null]
}

Table guidance_announcements {
  id bigint [pk, not null]
  guidance_id bigint [not null]
  guidance_name text [not null]
  title text [not null]
  message text [not null]
  audience text [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  emails_sent boolean
}

Table guidance_notification_reads {
  id integer [pk, not null]
  guidance_id integer [not null]
  notif_key text [not null]
  created_at timestamptz

  indexes {
    (guidance_id, notif_key) [unique]
  }
}

Table ict_announcements {
  id bigint [pk, not null]
  sender_id bigint [not null]
  sender_name text
  title text [not null]
  message text [not null]
  audience text[] [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz
  emails_sent boolean
}

Table ict_notification_reads {
  id bigint [pk, not null]
  ict_id bigint [not null]
  notif_key text [not null]
  created_at timestamptz

  indexes {
    (ict_id, notif_key) [unique]
  }
}

Table principal_announcements {
  id bigint [pk, not null]
  sender_id text [not null]
  title text [not null]
  message text [not null]
  audience text [not null]
  status text [not null]
  scheduled_at timestamptz
  created_at timestamptz
  emails_sent boolean
}

Table principal_notification_reads {
  id bigint [pk, not null]
  principal_id bigint [not null] // FK -> principals.id
  notif_key text [not null]
  created_at timestamptz

  indexes {
    (principal_id, notif_key) [unique]
  }
}

Table parent_announcement_notifications {
  id bigint [pk, not null]
  announcement_id bigint [not null]
  parent_id bigint [not null]
  student_id text
  grade text
  section text
  read_at timestamptz
  created_at timestamptz [not null]
  source text
  title text
  message text
  sender_name text
  unread boolean [not null]
  tab text [not null]

  indexes {
    (source, announcement_id, parent_id) [unique]
  }
}

Table principals {
  id bigint [pk, not null]
  employee_id text [not null]
  first_name text [not null]
  middle_name text
  last_name text [not null]
  suffix text
  email text [not null]
  phone text [not null]
  status text [not null]
  is_active boolean [not null]
  password_hash text [not null]
  password_set boolean [not null]
  auth_version uuid [not null]
  effective_date date
  succession_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
  archived_by text
  archive_reason text
  archive_status text [not null]
  archive_previous_status text
}

// Declared foreign keys represented within this import only.
Ref: adviser_notifications.announcement_id > announcements.id
Ref: principal_notification_reads.principal_id > principals.id

